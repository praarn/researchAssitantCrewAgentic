# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=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

# Model used for every agent call. openai/gpt-oss-120b is Groq's current
# free-tier recommended workhorse model (Groq deprecated llama-3.3-70b-versatile
# in June 2026 in favor of this one - see https://console.groq.com/docs/deprecations).
# Any Groq-hosted chat model that supports JSON mode will work here.
GROQ_MODEL=openai/gpt-oss-120b

# Max concurrent Groq requests in flight at once (keeps you inside free-tier
# rate limits when several sub-questions are researched in parallel).
GROQ_MAX_CONCURRENCY=3

# Max concurrent outbound web-search / page-fetch requests.
SEARCH_MAX_CONCURRENCY=5

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
